{
    "manifestVersion": 1,
    "id": "D2Ops",
    "publisher": "D2Ops",
    "version": "1.0.80",
    "name": "D2Ops",
    "description": "A sample Visual Studio Services extension",
    "public": false,
    "baseUri": "https://localhost:3000",
    "categories": ["Azure Repos"],
    "targets": [
        {
            "id": "Microsoft.VisualStudio.Services"
        }
    ],
    "icons": {
        "default": "images/logo.png"
     },
    "contributions": [
        {
            "id": "d2ops-hub-group",
            "type": "ms.vss-web.hub-group",
            "targets": [
                "ms.vss-web.project-hub-groups-collection"
            ],
            "properties": {
                "name": "D2Ops",
                "order": 100
            }
        },
        {
            "id": "d2ops",
            "type": "ms.vss-web.hub",
            "description": "Adds a 'Hello' hub to the Work hub group.",
            "targets": [
                ".d2ops-hub-group"
            ],
            "properties": {
                "name": "d2ops",
                "order": 99,
                "uri": "qmshub.html"
            }
        },
        {
            "id": "qmssettings",
            "type": "ms.vss-web.hub",
            "description": "Adds a QMS Settings hub to Organization settings hub group.",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "QMS Settings",
                "order": 99,
                "uri": "orghub.html"
            }
        }
    ],
    "files": [
        {
            "path": "qmshub.html",
            "addressable": true
        },
        {
            "path": "orghub.html",
            "addressable": true
        },
        
        {
            "path": "dist", "addressable": true
        },
        {
            "path": "images/logo.png", "addressable": true
        }
    ],
    
    "scopes":[ 
        "vso.work", 
        "vso.code_full",
        "vso.wiki_write",
        "vso.project_manage"
    ]  
}