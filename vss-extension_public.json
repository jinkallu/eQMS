{
    "manifestVersion": 1,
    "id": "QuatracePublic",
    "publisher": "D2Ops",
    "version": "1.0.5",
    "name": "QuatracePublic",
    "description": "Quatrace e QMS",
    "public": false,
    "categories": ["Azure Repos"],
    "baseUri": "https://localhost:3000",
    "targets": [
        {
            "id": "Microsoft.VisualStudio.Services.Cloud"
        }
    ],
    "icons": {
        "default": "images/logo.png"
     },
    "contributions": [
        {
            "id": "d2ops-hub-group",
            "type": "ms.vss-web.hub-group",
            "targets": [
                "ms.vss-web.project-hub-groups-collection"
            ],
            "restrictedTo": ["member", "public", "anonymous"],
            "properties": {
                "name": "Quatrace",
                "order": 100
            }
        },
        {
            "id": "d2ops-hub",
            "type": "ms.vss-web.hub",
            "description": "Adds a 'Hello' hub to the Work hub group.",
            "targets": [
                ".d2ops-hub-group"
            ],
            "restrictedTo": ["member", "public", "anonymous"],
            "properties": {
                "name": "Quatrace",
                "order": 99,
                "uri": "qmshub.html"
            }
        },
        {
            "id": "qmssettings",
            "type": "ms.vss-web.hub",
            "description": "Adds a QMS Settings hub to Organization settings hub group.",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "Quatrace Settings",
                "order": 99,
                "uri": "orghub.html"
            }
        }
    ],
    "files": [
        {
            "path": "qmshub.html",
            "addressable": true
        },
        {
            "path": "orghub.html",
            "addressable": true
        },
        
        {
            "path": "dist", "addressable": true
        },
        {
            "path": "images", "addressable": true
        },
        {
            "path": "node_modules/mxgraph/javascript/src", "addressable": true
        }
    ],
    
    "scopes":[ 
        "vso.work_full",
        "vso.code_full", 
        "vso.wiki_write",
        "vso.project_manage",
        "vso.profile_write",
        "vso.profile",
        "vso.serviceendpoint_manage",
        "vso.features_write"
    ]  
}
